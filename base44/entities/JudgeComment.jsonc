{
  "name": "JudgeComment",
  "type": "object",
  "properties": {
    "battle_id": {
      "type": "string",
      "title": "Battle ID"
    },
    "judge_id": {
      "type": "string",
      "title": "Judge ID"
    },
    "text": {
      "type": "string",
      "title": "Comment"
    }
  },
  "required": [
    "battle_id",
    "judge_id",
    "text"
  ],
  "rls": {
    "read": {},
    "create": {
      "$or": [
        {
          "data.judge_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.judge_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.judge_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}