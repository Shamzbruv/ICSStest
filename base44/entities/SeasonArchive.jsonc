{
  "name": "SeasonArchive",
  "type": "object",
  "properties": {
    "season_label": {
      "type": "string",
      "title": "Season Label"
    },
    "archived_date": {
      "type": "string",
      "title": "Archived Date"
    },
    "archived_by_id": {
      "type": "string",
      "title": "Archived By User ID"
    },
    "highlights": {
      "type": "array",
      "title": "Highlights Snapshot",
      "items": {
        "type": "object",
        "properties": {
          "battle_id": {
            "type": "string"
          },
          "battle_title": {
            "type": "string"
          },
          "winner_id": {
            "type": "string"
          },
          "winner_name": {
            "type": "string"
          },
          "winner_parish": {
            "type": "string"
          },
          "winner_image_url": {
            "type": "string"
          },
          "avg_performance": {
            "type": "number"
          },
          "avg_attire": {
            "type": "number"
          },
          "avg_crowd_engagement": {
            "type": "number"
          },
          "avg_total": {
            "type": "number"
          },
          "judges": {
            "type": "number"
          },
          "fan_votes": {
            "type": "number"
          }
        }
      }
    },
    "battle_count": {
      "type": "number",
      "title": "Battle Count",
      "default": 0
    },
    "total_votes": {
      "type": "number",
      "title": "Total Fan Votes",
      "default": 0
    }
  },
  "required": [
    "season_label"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}