{
  "name": "Battle",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "Title"
    },
    "subtitle": {
      "type": "string",
      "title": "Subtitle"
    },
    "contestant_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Contestant IDs"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "active",
        "closed"
      ],
      "default": "active"
    },
    "order": {
      "type": "number",
      "title": "Display Order",
      "default": 0
    }
  },
  "required": [
    "title",
    "contestant_ids"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}