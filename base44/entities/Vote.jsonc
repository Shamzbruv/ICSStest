{
  "name": "Vote",
  "type": "object",
  "properties": {
    "contestant_id": {
      "type": "string",
      "title": "Contestant ID"
    },
    "voter_id": {
      "type": "string",
      "title": "Voter ID"
    },
    "tokens_used": {
      "type": "number",
      "title": "Tokens Used",
      "default": 1
    },
    "battle_id": {
      "type": "string",
      "title": "Battle ID"
    }
  },
  "required": [
    "contestant_id"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}