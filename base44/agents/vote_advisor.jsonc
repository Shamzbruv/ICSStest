      "allowed_operations": [
        "read"
      ]
    },
    {
      "entity_name": "Contestant",
      "allowed_operations": [
        "read"
      ]
    },
    {
      "function_name": "getBattleResults",
      "description": "Get live fan vote tallies and judge scores for a specific battle"
    }
  ],
